<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('DS3Minimap'))">true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('DS3Minimap'))">true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="4.150.1" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
