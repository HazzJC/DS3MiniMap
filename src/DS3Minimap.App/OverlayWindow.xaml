<Window x:Class="DS3Minimap.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="True" ResizeMode="NoResize"
        Title="DS3 Minimap" Width="320" Height="320">
  <Grid x:Name="Root" Background="Transparent">
    <Border VerticalAlignment="Bottom" Margin="22" Padding="12,6"
            BorderBrush="#B38F7344" BorderThickness="1" CornerRadius="2">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#ED0B0A09" Offset="0" />
          <GradientStop Color="#DF211C15" Offset="0.52" />
          <GradientStop Color="#ED090908" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <TextBlock x:Name="StatusText" Foreground="#FFF0E3C8" FontSize="11"
                 FontFamily="Palatino Linotype" FontWeight="Medium"
                 Text="Starting DS3 Minimap..." TextAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
